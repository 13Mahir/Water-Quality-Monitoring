    [ "tds:VCC", "esp:3V3", "red", [ "h40", "v-120" ] ],
    [ "tds:GND", "esp:GND.1", "black", [ "h60", "v80" ] ],
    [ "tds:SIG", "esp:35", "orange", [ "h100", "v0" ] ],

    [ "temp:VCC", "esp:3V3", "red", [ "h-40", "v100" ] ],
    [ "temp:GND", "esp:GND.2", "black", [ "h-60", "v120" ] ],
    [ "temp:DQ", "esp:4", "green", [ "h-80", "v60" ] ],

    [ "lcd:VCC", "esp:3V3", "red", [ "v120" ] ],
    [ "lcd:GND", "esp:GND.3", "black", [ "v140" ] ],
