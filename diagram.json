{
  "version": 1,
  "author": "Mahir Shah",
  "editor": "wokwi",

  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 10, "left": -60 },

    { "type": "wokwi-potentiometer", "id": "ph", "top": -40, "left": -260, "attrs": { "travelLength": "30" } },
    { "type": "wokwi-potentiometer", "id": "tds", "top": 180, "left": -260, "attrs": { "travelLength": "30" } },

    { "type": "wokwi-ds18b20", "id": "temp", "top": -140, "left": 150 },

    { "type": "wokwi-lcd1602", "id": "lcd", "top": -200, "left": 100, "attrs": { "pins": "i2c" } },

    { "type": "wokwi-buzzer", "id": "buzzer", "top": 150, "left": 180, "attrs": { "volume": "0.1" } },

    { "type": "wokwi-led", "id": "ledRed", "top": 160, "left": -100, "rotate": 270, "attrs": { "color": "red" } },
