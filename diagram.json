    [ "ledRed:A", "esp:26", "red", [ "v-60" ] ],
    [ "ledRed:C", "esp:GND.1", "black", [ "h20", "v40" ] ],

    [ "ledGreen:A", "esp:27", "limegreen", [ "v-60" ] ],
    [ "ledGreen:C", "esp:GND.2", "black", [ "h-20", "v40" ] ]
